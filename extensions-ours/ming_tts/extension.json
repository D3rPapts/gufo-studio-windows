{
  "schema": 1,
  "name": "ming_tts",
  "version": "0.2.0",
  "api_version": ">= 0.2.0",
  "entry": "ming_tts_register",
  "registration_target": "gufo_ming_tts",
  "depends": [],
  "platforms": [
    "linux",
    "windows"
  ],
  "providers": [
    {
      "id": "ming-tts",
      "capability": "speech_synthesis",
      "keys": [
        "safetensors:ming_tts",
        "safetensors:BailingMMNativeForConditionalGeneration"
      ],
      "model_ids": [
        "ming-3.0-tts-0.5b",
        "ming-3.0-tts"
      ],
      "target": "gufo_ming_tts_provider",
      "entry": "ming_tts_provider_register",
      "serving": {
        "voices": true
      }
    }
  ],
  "targets": {
    "gufo_ming_tts": {
      "requires": []
    },
    "gufo_ming_tts_hip": {
      "requires": [
        "hip"
      ]
    },
    "gufo_ming_tts_provider": {
      "requires": []
    },
    "ming_tts_controls_test": {
      "role": "test",
      "requires": [
        "testing"
      ]
    },
    "ming_tts_oracle_test": {
      "role": "test",
      "requires": [
        "testing"
      ]
    },
    "ming_tts_provider_test": {
      "role": "test",
      "requires": [
        "testing"
      ]
    },
    "ming_tts_bench": {
      "role": "test",
      "requires": [
        "testing"
      ]
    },
    "ming_tts_hip_test": {
      "role": "test",
      "requires": [
        "hip",
        "testing"
      ]
    }
  },
  "production_paths": {
    "include": [
      "**/*.cpp",
      "**/*.h",
      "**/*.hpp",
      "**/*.hip",
      "extension.*"
    ],
    "exclude": [
      "tests/",
      "reference/"
    ]
  },
  "docs": {
    "title": "Ming-3.0-tts 0.5B",
    "inputs": "BF16 safetensors + CAM++ campplus.onnx; text, optional reference voice; emotion/tempo/pitch/volume/dialect controls in instructions",
    "guide": "README.md"
  },
  "tests": [
    {
      "target": "ming_tts_controls_test",
      "ctest": "ming_tts.controls",
      "check_pr": true,
      "windows_build": true
    }
  ],
  "test_labels": [
    "ming-tts"
  ],
  "fixtures": "reference/"
}
